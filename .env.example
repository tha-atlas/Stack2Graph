# Application configuration only. Each deployment has its own .env.example.
STACK2GRAPH_DATA_ROOT=/absolute/path/to/stack2graph-data
STACK2GRAPH_DATA_DIR=/absolute/path/to/stack2graph-data/datadump
STACK2GRAPH_DATA_XML_PATH=/absolute/path/to/stack2graph-data/datadump/xml
STACK2GRAPH_DATA_POSTGRES_PATH=/absolute/path/to/stack2graph-data/datadump/postgres

# XML workers: missing/empty/auto calibrates once per machine/table and saves it.
# A positive integer fixes workers instead; CPU/RAM caps still apply.
STACK2GRAPH_XML_WORKERS=auto

# Application PostgreSQL connection; configure the server independently in deployment/postgres/.env.
STACK2GRAPH_POSTGRES_HOST=127.0.0.1
STACK2GRAPH_POSTGRES_PORT=55432
STACK2GRAPH_POSTGRES_USER=example_user
STACK2GRAPH_POSTGRES_DATABASE=example_database
STACK2GRAPH_POSTGRES_PASSWORD_FILE=/absolute/path/to/local-password-file
STACK2GRAPH_POSTGRES_POOL_SIZE=1

# Independent native vector build: immutable published snapshot and remote Qdrant.
STACK2GRAPH_VECTOR_SNAPSHOT=published_snapshot_item_id
STACK2GRAPH_VECTOR_QDRANT_HOST=qdrant.example.invalid
STACK2GRAPH_VECTOR_QDRANT_HTTP_PORT=6333
STACK2GRAPH_VECTOR_QDRANT_GRPC_PORT=6334
STACK2GRAPH_VECTOR_QDRANT_TLS=false
STACK2GRAPH_VECTOR_QDRANT_API_KEY=replace_with_a_random_private_api_key
STACK2GRAPH_VECTOR_COLLECTION=stackoverflow_questions
# Initial single-node candidates; benchmark shard counts against the real workload.
STACK2GRAPH_VECTOR_SHARD_NUMBER=8
STACK2GRAPH_VECTOR_INDEXING_THRESHOLD_KB=10000
# CUDA-visible ordinals; each worker loads both pinned models.
# Required 40-character immutable Hub commit SHAs for the selected Qwen and BGE-M3.
STACK2GRAPH_VECTOR_DENSE_REVISION=replace_with_selected_qwen_commit_sha
STACK2GRAPH_VECTOR_SPARSE_REVISION=replace_with_bge_m3_commit_sha
STACK2GRAPH_VECTOR_MODEL_CACHE_DIR=/absolute/path/to/stack2graph-data/models
STACK2GRAPH_VECTOR_REPORT_DIR=/absolute/path/to/stack2graph-data/vector-reports
STACK2GRAPH_VECTOR_RUN_DIR=/absolute/path/to/stack2graph-data/vector-runs
STACK2GRAPH_VECTOR_SHARD_CHILDREN=8192
STACK2GRAPH_VECTOR_GPUS=0,1,2,3,4,5,6,7
STACK2GRAPH_VECTOR_DENSE_BATCH_TOKENS=65536
STACK2GRAPH_VECTOR_DENSE_BATCH_ROWS=256
STACK2GRAPH_VECTOR_EXTRACT_WORKERS=32
# Optional registry override; the packaged registry is the default.
# STACK2GRAPH_SELECTION_REGISTRY_PATH=/absolute/path/to/reviewed-registry.json
STACK2GRAPH_VECTOR_CHUNK_TOKENS=1024
STACK2GRAPH_VECTOR_CHUNK_OVERLAP=128
STACK2GRAPH_VECTOR_SPARSE_BATCH_SIZE=64
STACK2GRAPH_VECTOR_READ_BATCH_ROWS=1024
STACK2GRAPH_VECTOR_READ_BATCH_BYTES=16777216
STACK2GRAPH_VECTOR_UPLOAD_BATCH_POINTS=256
STACK2GRAPH_VECTOR_UPLOAD_WORKERS=4
STACK2GRAPH_VECTOR_LOAD_PROCESSES=8
# Omit CPU_WORKERS/RAM_BYTES to derive caps from visible CPU/cgroup and available RAM.
# STACK2GRAPH_VECTOR_CPU_WORKERS=8
# STACK2GRAPH_VECTOR_RAM_BYTES=4294967296
STACK2GRAPH_VECTOR_REQUEST_TIMEOUT_SECONDS=60
STACK2GRAPH_VECTOR_FINALIZE_TIMEOUT_SECONDS=3600
STACK2GRAPH_VECTOR_RETRY_ATTEMPTS=3

# Independent knowledge graph export from an explicit published snapshot.
# STACK2GRAPH_GRAPH_SNAPSHOT=<published-snapshot-id>
# STACK2GRAPH_GRAPH_RUN_DIR=/absolute/path/outside/repository/graph-runs
# STACK2GRAPH_GRAPH_RANGE_WIDTH=100000
# STACK2GRAPH_GRAPH_SHARD_BYTES=134217728
# Optional upper limits; CPU/RAM/database budgets are detected at startup.
# Defaults: at most 64 workers and 4096 question rows per byte-bounded batch.
# STACK2GRAPH_GRAPH_WORKERS=64
# STACK2GRAPH_GRAPH_RAM_BYTES=4294967296
# STACK2GRAPH_GRAPH_BATCH_ROWS=4096
# STACK2GRAPH_GRAPH_BATCH_BYTES=33554432
# STACK2GRAPH_GRAPH_RECORD_BYTES=16777216
# STACK2GRAPH_GRAPH_COMPRESSION=none
# STACK2GRAPH_GRAPH_COMPRESSION_LEVEL=1

# Host-side QLever build and client settings.
# Container image, server port, storage and runtime settings live in deployment/qlever/.env.
# Managed graph commands read that service configuration automatically.
# STACK2GRAPH_GRAPH_ARTIFACT_ROOT=/absolute/path/to/complete/graph-run
# STACK2GRAPH_QLEVER_EXECUTABLE=/absolute/path/to/qlever
# STACK2GRAPH_QLEVER_HOST=127.0.0.1
# STACK2GRAPH_QLEVER_INDEX_RAM_BYTES=4294967296
# STACK2GRAPH_QLEVER_INDEX_TIMEOUT_SECONDS=86400

# Optional graph temporary-space and filesystem-headroom limits.
# STACK2GRAPH_GRAPH_SPILL_BYTES=8589934592
# STACK2GRAPH_GRAPH_DISK_RESERVE_BYTES=268435456
