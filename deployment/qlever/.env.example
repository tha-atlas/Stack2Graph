# QLever server configuration; run.sh loads only this file.
# Graph builds require the host QLever CLI; service startup needs only Docker Compose.
STACK2GRAPH_QLEVER_IMAGE=registry.example/qlever@sha256:<verified-runtime-digest>
STACK2GRAPH_QLEVER_INDEX_ROOT=/absolute/path/to/stack2graph-data/graph-indexes
STACK2GRAPH_QLEVER_DEPLOYMENT_ROOT=/absolute/path/to/stack2graph-data/qlever-deployment
STACK2GRAPH_QLEVER_COMPOSE_PROJECT=stack2graph-qlever
STACK2GRAPH_QLEVER_CONTAINER_NAME=stack2graph-qlever
STACK2GRAPH_QLEVER_NETWORK=stack2graph-qlever
STACK2GRAPH_QLEVER_PORT=7015
STACK2GRAPH_QLEVER_QUERY_RAM_BYTES=68719476736
STACK2GRAPH_QLEVER_TIMEOUT_SECONDS=3600
