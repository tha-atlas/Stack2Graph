# Shared HTTPS gateway. Qdrant and QLever credentials do not belong here.
STACK2GRAPH_GATEWAY_IMAGE=nginx:stable
STACK2GRAPH_GATEWAY_COMPOSE_PROJECT=stack2graph-gateway
STACK2GRAPH_GATEWAY_CONTAINER_NAME=stack2graph-gateway
STACK2GRAPH_GATEWAY_SERVER_NAME=services.example.com
STACK2GRAPH_GATEWAY_CERT_FILE=/absolute/path/to/certs/fullchain.pem
STACK2GRAPH_GATEWAY_KEY_FILE=/absolute/path/to/certs/private-key.pem
# Host CA trust store; use a private CA bundle for privately issued certificates.
STACK2GRAPH_GATEWAY_CA_FILE=/etc/ssl/certs/ca-certificates.crt
STACK2GRAPH_GATEWAY_HTTPS_BIND=0.0.0.0
STACK2GRAPH_GATEWAY_HTTPS_PORT=443
# Backend listener ports, configured independently of application client endpoints.
STACK2GRAPH_GATEWAY_QDRANT_PORT=6333
STACK2GRAPH_GATEWAY_QDRANT_GRPC_PORT=6334
STACK2GRAPH_GATEWAY_QLEVER_PORT=7015
