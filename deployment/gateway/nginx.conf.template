server {
    listen ${GATEWAY_HTTPS_BIND}:${GATEWAY_HTTPS_PORT} ssl;
    http2 on;
    server_name ${GATEWAY_SERVER_NAME};
    ssl_certificate /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:GatewayTLS:10m;
    ssl_session_tickets off;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 7200s;
    proxy_send_timeout 7200s;
    client_max_body_size 100M;

    location = /gateway/health {
        access_log off;
        return 204;
    }

    # Qdrant REST, dashboard and native gRPC. Authentication headers and gRPC
    # metadata pass through unchanged; the gateway stores no Qdrant API key.
    location /qdrant. {
        grpc_pass grpc://127.0.0.1:${QDRANT_GRPC_PORT};
        grpc_set_header Host $host;
        grpc_read_timeout 7200s;
        grpc_send_timeout 7200s;
    }
    location = /qdrant {
        proxy_pass http://127.0.0.1:${QDRANT_PORT}/;
    }
    location /qdrant/ {
        proxy_pass http://127.0.0.1:${QDRANT_PORT}/;
    }
    location = /dashboard {
        return 302 /qdrant/dashboard$is_args$args;
    }
    location = /dashboard/ {
        return 302 /qdrant/dashboard$is_args$args;
    }
    location /dashboard/ {
        proxy_pass http://127.0.0.1:${QDRANT_PORT}/dashboard/;
    }
    # QLever's native SPARQL API, with the public prefix removed.
    location = /qlever {
        rewrite ^ / break;
        proxy_pass http://127.0.0.1:${QLEVER_PORT};
        proxy_buffering off;
    }
    location ^~ /qlever/ {
        rewrite ^/qlever/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:${QLEVER_PORT};
        proxy_buffering off;
    }

    # Qdrant clients use its native unprefixed REST paths.
    location / {
        proxy_pass http://127.0.0.1:${QDRANT_PORT};
    }
}
