# PostgreSQL server configuration; run.sh loads only this file.
# Host UID/GID are derived at launch and are never stored here.
# These server settings are independent of the application connection in root .env.
STACK2GRAPH_DATA_POSTGRES_PATH=/absolute/path/to/stack2graph-data/datadump/postgres
STACK2GRAPH_POSTGRES_PORT=55432
STACK2GRAPH_POSTGRES_USER=example_user
STACK2GRAPH_POSTGRES_DATABASE=example_database
STACK2GRAPH_POSTGRES_PASSWORD_FILE=/absolute/path/to/local-password-file
STACK2GRAPH_POSTGRES_BIND_ADDRESS=127.0.0.1
STACK2GRAPH_POSTGRES_IMAGE=postgres:alpine
STACK2GRAPH_POSTGRES_MEMORY_LIMIT=0
STACK2GRAPH_POSTGRES_CPU_LIMIT=0
STACK2GRAPH_POSTGRES_SHM_SIZE=64gb

# Independent project identity, shutdown and log rotation.
STACK2GRAPH_POSTGRES_COMPOSE_PROJECT=stack2graph-postgres
STACK2GRAPH_POSTGRES_CONTAINER_NAME=stack2graph-postgres
STACK2GRAPH_POSTGRES_STOP_GRACE=120s
STACK2GRAPH_POSTGRES_LOG_MAX_SIZE=10m
STACK2GRAPH_POSTGRES_LOG_MAX_FILES=3

# Optional tuning overrides; omit them to derive budgets from host/cgroup limits.
# STACK2GRAPH_POSTGRES_MAX_CONNECTIONS=64
# STACK2GRAPH_POSTGRES_SHARED_BUFFERS=256MB
# STACK2GRAPH_POSTGRES_MAINTENANCE_MEMORY=64MB
# STACK2GRAPH_POSTGRES_WORK_MEMORY=4MB
# STACK2GRAPH_POSTGRES_MAX_WAL_SIZE=1GB
# STACK2GRAPH_POSTGRES_TEMP_FILE_LIMIT=1GB
