# Qdrant server configuration; run.sh loads only this file.
# Host UID/GID are derived at launch and are never stored here.
# Server ports can differ from the application client ports when using the HTTPS gateway.
STACK2GRAPH_DATA_ROOT=/absolute/path/to/stack2graph-data
STACK2GRAPH_VECTOR_QDRANT_HTTP_PORT=6333
STACK2GRAPH_VECTOR_QDRANT_GRPC_PORT=6334
STACK2GRAPH_VECTOR_QDRANT_API_KEY=replace_with_a_random_private_api_key
STACK2GRAPH_VECTOR_QDRANT_IMAGE=qdrant/qdrant:v1.19
STACK2GRAPH_VECTOR_QDRANT_COMPOSE_PROJECT=stack2graph-qdrant
STACK2GRAPH_VECTOR_QDRANT_CONTAINER_NAME=stack2graph-qdrant
